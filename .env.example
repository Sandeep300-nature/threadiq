# Groq Cloud API Key (Server-side only)
# Used by ThreadIQ server middleware to generate stock intelligence interpretations.
# NEVER prefix with VITE_ to keep the key strictly on the server and out of client bundles.
GROQ_API_KEY=your_groq_api_key_here

# ThreadIQ API Configuration
# When this endpoint is available, the frontend services will connect to it.
# When offline or unreachable, the frontend automatically falls back to mock data.
VITE_API_BASE_URL=http://localhost:8000

# Optional: Map Tile Provider Key
# CARTO raster basemaps enforce an API key to avoid watermark overlays.
# If omitted or empty, ThreadIQ automatically uses legitimate OpenStreetMap tiles.
# VITE_CARTO_API_KEY=your_carto_api_key_here

