{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/employee/css/(.*)",
      "destination": "/employee/css/$1"
    },
    {
      "source": "/employee/js/(.*)",
      "destination": "/employee/js/$1"
    },
    {
      "source": "/employee",
      "destination": "/employee/index.html"
    },
    {
      "source": "/employee/",
      "destination": "/employee/index.html"
    },
    {
      "source": "/employee/dashboard",
      "destination": "/employee/index.html"
    },
    {
      "source": "/employee/inventory",
      "destination": "/employee/index.html"
    },
    {
      "source": "/employee/transfers",
      "destination": "/employee/index.html"
    },
    {
      "source": "/employee/history",
      "destination": "/employee/index.html"
    },
    {
      "source": "/employee/settings",
      "destination": "/employee/index.html"
    },
    {
      "source": "/employee/(.*)",
      "destination": "/employee/index.html"
    },
    {
      "source": "/manager/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/manager",
      "destination": "/index.html"
    },
    {
      "source": "/overview",
      "destination": "/index.html"
    },
    {
      "source": "/inventory",
      "destination": "/index.html"
    },
    {
      "source": "/stores",
      "destination": "/index.html"
    },
    {
      "source": "/transfers",
      "destination": "/index.html"
    },
    {
      "source": "/approvals",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
